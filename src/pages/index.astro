---
import V2Layout from '../layouts/V2Layout.astro';
import { featuredProjects as projects } from '../data/projects';
---

<V2Layout>
  <!-- HERO -->
  <section class="hero" id="top">
    <p class="hero-eyebrow"><span class="eyebrow-line"></span>An AI-forward agency for software &amp; websites</p>
    <h1 class="hero-title" aria-label="fkealy">
      <span class="line"><span class="word" data-split>fkealy</span><span class="hero-dot">.</span></span>
    </h1>
    <div class="hero-foot">
      <p class="hero-tagline">From first idea to launched product.<br />Built to work, and keep working.</p>
      <div class="hero-meta">
        <p>Design + engineering</p>
        <p>UK / remote</p>
      </div>
    </div>
    <a class="scroll-hint" href="#work" data-hover aria-label="Scroll to work">
      <span>Scroll</span>
      <svg width="12" height="32" viewBox="0 0 12 32" fill="none" aria-hidden="true">
        <path d="M6 0v28m0 0l5-5m-5 5l-5-5" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </a>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 2 }).map(() => (
        <span class="marquee-chunk">
          AI-forward <i>✦</i> Idea to delivery <i>✦</i> Websites <i>✦</i> Products <i>✦</i> No drama at the back <i>✦</i> UK / Remote <i>✦</i>&nbsp;
        </span>
      ))}
    </div>
  </div>

  <!-- WORK -->
  <section class="work" id="work">
    <div class="section-head">
      <h2 class="section-title" data-reveal>Selected work</h2>
      <p class="section-count">({projects.length})</p>
    </div>
    <ul class="work-list">
      {projects.map((p, i) => (
        <li class="work-row" data-row id={p.slug}>
          <button
            class="work-link work-toggle"
            type="button"
            aria-expanded="false"
            aria-controls={`panel-${p.slug}`}
            data-hover
          >
            <span class="work-index">0{i + 1}</span>
            <span class="work-main">
              <span class="work-title">{p.title}</span>
              <span class="work-blurb">{p.blurb}</span>
            </span>
            <span class="work-side">
              {p.deploy && <span class="work-tags">{p.deploy}</span>}
            </span>
            <span class="work-arrow" aria-hidden="true">+</span>
          </button>
          <div class="work-panel" id={`panel-${p.slug}`}>
            <div class="work-panel-inner">
              <div class="work-shots">
                <img
                  src={`/assets/work/${p.slug}-desktop.jpeg`}
                  alt={`${p.title} on desktop`}
                  loading="lazy"
                  class="shot-desktop"
                />
                <img
                  src={`/assets/work/${p.slug}-mobile.jpeg`}
                  alt={`${p.title} on a phone`}
                  loading="lazy"
                  class="shot-mobile"
                />
              </div>
              <div class="work-panel-text">
                <p class="work-story">{p.story}</p>
                {p.link && (
                  <a
                    class="ghost-link work-live"
                    href={p.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-hover
                  >
                    See it live ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="ghost-row">
      <a class="ghost-link" href="/concepts" data-hover>
        Concepts →
      </a>
    </div>
  </section>

  <!-- ABOUT / STATEMENT -->
  <section class="about" id="about">
    <p class="statement">
      <span class="statement-line">AI makes building fast.</span>
      <span class="statement-line">10 years of fundamentals keep it right.</span>
      <span class="statement-line">We use both, and read every line.</span>
      <span class="statement-line statement-accent">So a small hallucination doesn't cost you your business.</span>
    </p>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <p class="contact-kicker" data-reveal>Got something to build?</p>
    <a class="contact-big" href="mailto:fkealy.dev@gmail.com?subject=Project%20enquiry" data-hover data-magnetic>
      <span class="word" data-split>START&nbsp;A&nbsp;PROJECT</span>
    </a>
    <div class="contact-links">
      <a href="https://github.com/fkealy" target="_blank" rel="noopener noreferrer" data-hover>GitHub</a>
      <a href="https://www.linkedin.com/in/freddie-kealy-140b05b5/" target="_blank" rel="noopener noreferrer" data-hover>LinkedIn</a>
      <a href="/blog" data-hover>Blog</a>
      <a href="/cv" data-hover>CV</a>
    </div>
    <p class="contact-foot">© {new Date().getFullYear()} fkealy · Built with Astro, GSAP & three.js</p>
  </section>

  <style is:global>
    /* Hero */
    .hero {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      padding-top: 6rem;
    }
    .hero-eyebrow {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      font-family: var(--font-mono);
      font-size: clamp(0.7rem, 1.4vw, 0.85rem);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--accent);
      margin-bottom: clamp(1rem, 3vw, 2rem);
      opacity: 0;
    }
    .eyebrow-line {
      display: inline-block;
      width: 3rem;
      height: 1px;
      background: var(--accent);
    }
    .hero-title {
      font-weight: 600;
      font-size: clamp(3.8rem, 17vw, 15rem);
      /* Roomy enough that the y's descender survives the overflow mask */
      line-height: 1.12;
      letter-spacing: -0.04em;
      text-transform: none;
    }
    .hero-title .line { display: block; overflow: hidden; }
    .word { display: inline-block; }
    .hero-dot {
      display: inline-block;
      color: var(--accent);
    }
    .hero-foot {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
      margin-top: clamp(2rem, 5vw, 4rem);
      flex-wrap: wrap;
      opacity: 0;
    }
    .hero-tagline {
      font-size: clamp(1.05rem, 2.4vw, 1.6rem);
      line-height: 1.4;
      max-width: 34ch;
      color: var(--ink);
    }
    .hero-meta {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--ink-dim);
      text-align: right;
      line-height: 1.9;
    }
    .scroll-hint {
      position: absolute;
      bottom: 2rem;
      left: clamp(1.25rem, 4vw, 3rem);
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      color: var(--ink-dim);
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      opacity: 0;
    }
    .scroll-hint svg { animation: bob 2s ease-in-out infinite; }
    @keyframes bob {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(5px); }
    }

    /* Marquee */
    .marquee {
      overflow: hidden;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 0.9rem 0;
      background: rgba(10, 10, 14, 0.55);
      backdrop-filter: blur(4px);
      position: relative;
      z-index: 2;
    }
    .marquee-track {
      display: flex;
      width: max-content;
      /* Slow drift, not a ticker: the page stays calm. */
      animation: marquee 75s linear infinite;
    }
    .marquee-chunk {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: var(--ink-dim);
      white-space: nowrap;
    }
    .marquee-chunk i {
      font-style: normal;
      color: var(--ink-dim);
      padding: 0 1.2rem;
    }
    @keyframes marquee {
      to { transform: translateX(-50%); }
    }

    /* Work list */
    .work-list { list-style: none; }
    .work-row { border-bottom: 1px solid var(--line); }
    .work-toggle {
      width: 100%;
      background: none;
      border: none;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }
    .work-link {
      display: grid;
      grid-template-columns: auto 1fr auto auto;
      align-items: center;
      gap: clamp(1rem, 3vw, 2.5rem);
      padding: clamp(1.4rem, 3vw, 2.2rem) 0.5rem;
      color: var(--ink);
      text-decoration: none;
      position: relative;
      transition: padding-left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .work-link::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(245, 185, 66, 0.09), transparent 65%);
      opacity: 0;
      transition: opacity 0.35s ease;
      pointer-events: none;
    }
    @media (hover: hover) {
      .work-link:hover { padding-left: 1.6rem; }
      .work-link:hover::before { opacity: 1; }
      .work-link:hover .work-title { color: var(--accent); }
      .work-link:hover .work-arrow { transform: translate(4px, -4px); color: var(--accent); }
    }
    .work-index {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--ink-dim);
    }
    .work-title {
      display: block;
      font-size: clamp(1.5rem, 4.5vw, 3.2rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      transition: color 0.3s ease;
    }
    .work-blurb {
      display: block;
      margin-top: 0.4rem;
      color: var(--ink-dim);
      font-size: clamp(0.85rem, 1.8vw, 1rem);
      max-width: 52ch;
      line-height: 1.5;
    }
    .work-side {
      text-align: right;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-dim);
      line-height: 1.9;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .work-arrow {
      font-size: clamp(1.2rem, 3vw, 1.8rem);
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s ease;
    }
    .work-row.is-open .work-arrow {
      transform: rotate(45deg);
      color: var(--accent);
    }
    @media (hover: hover) {
      .work-row.is-open .work-link:hover .work-arrow { transform: rotate(45deg); }
    }
    @media (max-width: 700px) {
      .work-link { grid-template-columns: auto 1fr auto; }
      .work-side { display: none; }
    }

    /* Expanding panel: first click gets the story, second gets the live site */
    .work-panel {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .work-row.is-open .work-panel { grid-template-rows: 1fr; }
    .work-panel-inner {
      overflow: hidden;
      min-height: 0;
    }
    .work-shots {
      display: flex;
      gap: clamp(0.8rem, 2vw, 1.4rem);
      align-items: flex-start;
      padding-top: 0.5rem;
    }
    .work-shots img {
      border: 1px solid var(--line);
      border-radius: 4px;
      display: block;
      height: auto;
    }
    .shot-desktop {
      flex: 1 1 0;
      min-width: 0;
      max-width: 720px;
    }
    .shot-mobile {
      flex: 0 0 clamp(90px, 18vw, 200px);
      max-width: 200px;
    }
    .work-panel-text {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: clamp(1rem, 3vw, 2.5rem);
      flex-wrap: wrap;
      padding-bottom: clamp(1.4rem, 3vw, 2.2rem);
    }
    .work-story {
      color: var(--ink-dim);
      line-height: 1.6;
      max-width: 58ch;
      font-size: clamp(0.9rem, 1.9vw, 1.05rem);
      margin-top: clamp(1rem, 2.5vw, 1.6rem);
    }
    .work-live { margin-top: clamp(1rem, 2.5vw, 1.6rem); }
    @media (max-width: 700px) {
      .shot-mobile { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .work-panel, .work-arrow { transition: none !important; }
    }
    .ghost-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    /* About statement */
    .about { text-align: left; }
    .statement {
      font-size: clamp(1.6rem, 4.6vw, 3.6rem);
      font-weight: 500;
      line-height: 1.25;
      letter-spacing: -0.02em;
      max-width: 24em;
    }
    .statement-line { display: block; }
    .statement-accent { color: var(--accent); }

    /* Contact */
    .contact {
      text-align: center;
      padding-bottom: 3rem;
    }
    .contact-kicker {
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: clamp(0.75rem, 1.6vw, 0.95rem);
      color: var(--ink-dim);
      margin-bottom: 1.5rem;
    }
    .contact-big {
      display: inline-block;
      font-size: clamp(2.2rem, 9.5vw, 8.5rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      color: transparent;
      -webkit-text-stroke: 2px var(--ink);
      text-decoration: none;
      line-height: 1;
      overflow: hidden;
      transition: color 0.4s ease, -webkit-text-stroke-color 0.4s ease;
      will-change: transform;
    }
    .contact-big:hover {
      color: var(--accent);
      -webkit-text-stroke-color: var(--accent);
    }
    @media (max-width: 600px) {
      .contact-big { -webkit-text-stroke-width: 1.2px; }
    }
    .contact-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: clamp(1.2rem, 4vw, 2.5rem);
      margin-top: clamp(2rem, 5vw, 3.5rem);
    }
    .contact-links a {
      color: var(--ink);
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.3rem;
      transition: color 0.25s, border-color 0.25s;
    }
    .contact-links a:hover { color: var(--accent); border-color: var(--accent); }
    .contact-foot {
      margin-top: clamp(2.5rem, 6vw, 4rem);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--ink-dim);
      letter-spacing: 0.08em;
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee-track, .scroll-hint svg { animation: none !important; }
    }
  </style>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { reduceMotion, splitChars } from '../scripts/v2';

    gsap.registerPlugin(ScrollTrigger);

    // Work rows: first click opens the panel; the live link sits inside it.
    // One panel open at a time.
    document.querySelectorAll('.work-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.work-row');
        if (!row) return;
        const wasOpen = row.classList.contains('is-open');
        document.querySelectorAll('.work-row.is-open').forEach((r) => {
          r.classList.remove('is-open');
          r.querySelector('.work-toggle')?.setAttribute('aria-expanded', 'false');
        });
        if (!wasOpen) {
          row.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
        // The page height changes under the scroll triggers.
        setTimeout(() => ScrollTrigger.refresh(), 600);
      });
    });

    if (reduceMotion) {
      gsap.set('.hero-eyebrow, .hero-foot, .scroll-hint', { opacity: 1 });
    } else {
      // Hero intro
      const heroChars = Array.from(document.querySelectorAll('.hero-title [data-split]')).flatMap(splitChars);
      const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
      tl.from(heroChars, {
        yPercent: 115,
        rotate: 4,
        duration: 1.1,
        stagger: 0.035,
        delay: 0.15,
      })
        .from('.hero-dot', { yPercent: 115, duration: 0.7 }, '-=0.6')
        .to('.hero-eyebrow', { opacity: 1, duration: 0.7 }, '-=0.7')
        .to('.hero-foot', { opacity: 1, duration: 0.7 }, '-=0.45')
        .to('.scroll-hint', { opacity: 1, duration: 0.7 }, '-=0.4');

      // If rAF stalls (background tab on load, odd embedded contexts), make
      // sure the hero never stays hidden.
      setTimeout(() => {
        if (tl.progress() < 1) tl.progress(1);
      }, 3500);

      // Hero parallax out
      gsap.to('.hero-title', {
        yPercent: -18,
        opacity: 0.25,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
      });

      // Section title reveals
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        gsap.from(el, {
          y: 50,
          opacity: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%' },
        });
      });

      // Row reveals — kept gentle so the section titles carry the energy
      document.querySelectorAll('[data-row]').forEach((el) => {
        gsap.from(el, {
          y: 24,
          opacity: 0,
          duration: 1,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 92%' },
        });
      });

      // Statement lines
      gsap.from('.statement-line', {
        y: 18,
        opacity: 0,
        duration: 1,
        stagger: 0.12,
        ease: 'power2.out',
        scrollTrigger: { trigger: '.statement', start: 'top 80%' },
      });

      // Contact big-type reveal
      const contactChars = Array.from(document.querySelectorAll('.contact-big [data-split]')).flatMap(splitChars);
      gsap.from(contactChars, {
        yPercent: 110,
        duration: 0.9,
        stagger: 0.04,
        ease: 'power4.out',
        scrollTrigger: { trigger: '.contact', start: 'top 70%' },
      });
    }
  </script>
</V2Layout>
